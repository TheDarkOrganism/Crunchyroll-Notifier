<?xml version="1.0" encoding="utf-8"?>
<Window
	x:Class="WinUIApp.Settings"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:WinUIApp"
	xmlns:controls="using:WinUIApp.Controls"
	xmlns:models="using:WinUIApp.Models"
	xmlns:markup="using:WinUIApp.Markup"
	xmlns:enums="using:WinUIApp.Enums"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d"
	Title="Settings"
	Closed="Window_Closed">
	<ScrollViewer VerticalAlignment="Top">
		
		<ScrollViewer.Resources>
			
			<Style x:Key="GridStyle" TargetType="Grid">
				<Setter Property="ColumnSpacing" Value="10" />
				<Setter Property="RowSpacing" Value="20" />
			</Style>
			
		</ScrollViewer.Resources>

		<Grid x:Name="LayoutGrid" Style="{StaticResource GridStyle}" Padding="10" d:DataContext="{d:DesignInstance Type=models:ConfigModel}">
			
			<Grid.Resources>

				<ResourceDictionary>

					<ResourceDictionary.MergedDictionaries>
						<ResourceDictionary Source="/Validation/ValidationTemplates.xaml" />
					</ResourceDictionary.MergedDictionaries>

					<!-- Styles -->

					<Style x:Key="LabelStyle" TargetType="TextBlock">
						<Setter Property="VerticalAlignment" Value="Center" />
					</Style>

					<Style x:Key="InputStyle" TargetType="Control" BasedOn="{StaticResource ValidatedInputStyle}">
						<Setter Property="Grid.Column" Value="1" />
						<Setter Property="HorizontalAlignment" Value="Stretch" />
					</Style>

					<Style x:Key="DropdownStyle" TargetType="ComboBox" BasedOn="{StaticResource InputStyle}">
						<Setter Property="HorizontalAlignment" Value="Right" />
						<Setter Property="MinWidth" Value="100" />
					</Style>

					<Style x:Key="InputContainerStyle" TargetType="Grid" BasedOn="{StaticResource GridStyle}">
						<Setter Property="Grid.Column" Value="1" />
						<Setter Property="HorizontalAlignment" Value="Right" />
					</Style>

					<Style x:Key="AddButtonStyle" TargetType="Button">
						<Setter Property="Content" Value="Add" />
					</Style>

					<Style x:Key="RemoveButtonStyle" TargetType="Button">
						<Setter Property="Content" Value="Remove" />
						<Setter Property="Grid.Column" Value="1" />
					</Style>

					<Style x:Key="ValueListStyle" TargetType="ListView" BasedOn="{StaticResource ValidatedInputStyle}">
						<Setter Property="Grid.ColumnSpan" Value="2" />
						<Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
					</Style>

					<markup:EnumToIndexConverter x:Key="EnumIndexConverter" />

				</ResourceDictionary>

			</Grid.Resources>

			<!--#region Grid Definitions -->

			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>

			<Grid.RowDefinitions>
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
			</Grid.RowDefinitions>
				
			<!--#endregion-->
			
			<!--#region Save Warning -->

			<TextBlock Text="Changes will be saved when this window closes or when the application exits." Style="{StaticResource LabelStyle}" Foreground="Red" Grid.ColumnSpan="2" TextWrapping="WrapWholeWords" />

			<!--#endregion-->
			
			<!--#region Interval -->

			<TextBlock Text="Interval" Grid.Row="1" Style="{StaticResource LabelStyle}" />

			<controls:CustomTimePicker Grid.Row="1" Time="{Binding Interval, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" HorizontalAlignment="Right" Loaded="Control_Loaded" />

			<!--#endregion-->

			<!--#region Visibility -->

			<TextBlock Text="Visibility" Grid.Row="2" Style="{StaticResource LabelStyle}" />

			<ComboBox Grid.Row="2" Template="{StaticResource ComboBoxErrorTemplate}" ItemsSource="{Binding Source={markup:EnumBinding EnumType=enums:VisibilityType}, Mode=OneTime}" SelectedItem="{Binding Visibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedIndex="{Binding Visibility, Converter={StaticResource EnumIndexConverter}, Mode=OneTime}" Style="{StaticResource DropdownStyle}" Loaded="Control_Loaded" />

			<!--#endregion-->
			
			<!--#region Feed Host -->

			<TextBlock Text="Feed Host" Grid.Row="3" Style="{StaticResource LabelStyle}" />

			<ComboBox Grid.Row="3" Template="{StaticResource ComboBoxErrorTemplate}" ItemsSource="{Binding Source={markup:EnumBinding EnumType=enums:FeedHostType}, Mode=OneTime}" SelectedItem="{Binding FeedHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedIndex="{Binding FeedHost, Converter={StaticResource EnumIndexConverter}, Mode=OneTime}" Style="{StaticResource DropdownStyle}" Loaded="Control_Loaded" />
			
			<!--#endregion-->

			<!--#region  Max Notifications -->

			<TextBlock Text="Max Notifications" Grid.Row="4" Style="{StaticResource LabelStyle}" />

			<NumberBox Grid.Row="4" Template="{StaticResource NumberBoxErrorTemplate}" Minimum="1" Maximum="100" SmallChange="1" LargeChange="10" Value="{Binding MaxNotifications, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" ValueChanged="NumberBox_ValueChanged" Loaded="Control_Loaded" />

			<!--#endregion-->
			
			<!--#region  Show First Run -->

			<TextBlock Text="Show on first run" Grid.Row="5" Style="{StaticResource LabelStyle}" />

			<StackPanel Grid.Row="5" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Width="31">
				<CheckBox IsChecked="{Binding ShowFirstRun, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" HorizontalContentAlignment="Center" />
			</StackPanel>

			<!--#endregion-->
			
			<!--#region Dubs -->

			<TextBlock Text="Dubs" Grid.Row="6" Style="{StaticResource LabelStyle}" />

			<Grid Grid.Row="7" Style="{StaticResource InputContainerStyle}">
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>

				<Button Style="{StaticResource AddButtonStyle}" Click="DubsAddButton_Click" />
				<Button Style="{StaticResource RemoveButtonStyle}" Click="DubsRemoveButton_Click" />
			</Grid>

			<ListView x:Name="DubsValues" Grid.Row="8" Template="{StaticResource ListViewBaseErrorTemplate}" ItemsSource="{Binding Dubs, Mode=OneWay}" Style="{StaticResource ValueListStyle}" Loaded="Control_Loaded" />

			<!--#endregion-->
			
			<!--#region Names -->

			<TextBlock Text="Names" Grid.Row="9" Style="{StaticResource LabelStyle}" />

			<Grid Grid.Row="10" Style="{StaticResource InputContainerStyle}">
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition />
				</Grid.ColumnDefinitions>

				<Button Style="{StaticResource AddButtonStyle}" Click="NamesAddButton_Click" />
				<Button Style="{StaticResource RemoveButtonStyle}" Click="NamesRemoveButton_Click" />
			</Grid>

			<ListView x:Name="NamesValues" Grid.Row="11" Template="{StaticResource ListViewBaseErrorTemplate}" ItemsSource="{Binding Names, Mode=OneWay}" Style="{StaticResource ValueListStyle}" Loaded="Control_Loaded" />

			<!--#endregion-->
		</Grid>
	</ScrollViewer>
</Window>