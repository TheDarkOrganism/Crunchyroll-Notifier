<UserControl
	x:Class="WinUIApp.Controls.CustomTimePicker"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<UserControl.Resources>
		<ResourceDictionary Source="/Validation/ValidationTemplates.xaml" />
	</UserControl.Resources>

	<StackPanel Style="{StaticResource ContentContainerStyle}">
		<TextBlock x:Name="ErrorContent" Style="{StaticResource ErrorContentStyle}" />
		
		<Grid>
			<Border x:Name="ErrorBorder" />
			
			<Button x:Name="TimeButton">
				<Button.Flyout>
					<Flyout Placement="Bottom">
						<Flyout.FlyoutPresenterStyle>
							<Style TargetType="FlyoutPresenter">
								<Setter Property="MinWidth" Value="200" />
								<Setter Property="Padding" Value="10" />
							</Style>
						</Flyout.FlyoutPresenterStyle>

						<StackPanel Orientation="Horizontal" Spacing="10">
							<StackPanel.Resources>
								<Style x:Key="ComboBoxStyle" TargetType="ComboBox">
									<Setter Property="Width" Value="60" />
								</Style>
								<Style x:Key="SplitterStyle" TargetType="TextBlock">
									<Setter Property="VerticalAlignment" Value="Center" />
								</Style>
							</StackPanel.Resources>

							<ComboBox ItemsSource="{x:Bind _range24, Mode=OneTime}" SelectedValue="{x:Bind _hours, Mode=TwoWay}" Style="{StaticResource ComboBoxStyle}" SelectionChanged="ComboBox_SelectionChanged" />

							<TextBlock Text=":" Style="{StaticResource SplitterStyle}" />

							<ComboBox ItemsSource="{x:Bind _range60, Mode=OneTime}" SelectedValue="{x:Bind _minutes, Mode=TwoWay}" Style="{StaticResource ComboBoxStyle}" SelectionChanged="ComboBox_SelectionChanged" />

							<TextBlock Text=":" Style="{StaticResource SplitterStyle}" />

							<ComboBox ItemsSource="{x:Bind _range60, Mode=OneTime}" SelectedValue="{x:Bind _seconds, Mode=TwoWay}" Style="{StaticResource ComboBoxStyle}" SelectionChanged="ComboBox_SelectionChanged" />
						</StackPanel>
					</Flyout>
				</Button.Flyout>

				<Button.Content>
					<TextBlock x:Name="TimeContent" />
				</Button.Content>
			</Button>
		</Grid>

		<VisualStateManager.VisualStateGroups>
			<VisualStateGroup>
				<VisualState x:Name="Valid" />

				<VisualState x:Name="Invalid">
					<Storyboard>
						<ObjectAnimationUsingKeyFrames Storyboard.TargetName="ErrorContent" Storyboard.TargetProperty="Visibility">
							<DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
						</ObjectAnimationUsingKeyFrames>
						<ObjectAnimationUsingKeyFrames Storyboard.TargetName="ErrorBorder" Storyboard.TargetProperty="BorderBrush">
							<DiscreteObjectKeyFrame KeyTime="0" Value="Red" />
						</ObjectAnimationUsingKeyFrames>
					</Storyboard>
				</VisualState>
			</VisualStateGroup>
		</VisualStateManager.VisualStateGroups>
	</StackPanel>
</UserControl>