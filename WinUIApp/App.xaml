<?xml version="1.0" encoding="utf-8"?>
<Application
	x:Class="WinUIApp.App"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:tray="using:H.NotifyIcon">
	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
			</ResourceDictionary.MergedDictionaries>

			<ResourceDictionary x:Key="Tray">
				<XamlUICommand x:Key="Settings" Label="Settings" Description="Opens the settings." />

				<XamlUICommand x:Key="Exit" Label="Exit" Description="Closes the application." />

				<tray:TaskbarIcon x:Key="TrayIcon" LeftClickCommand="{StaticResource Settings}" IconSource="/Crunchyroll-Notifier.ico">
					<tray:TaskbarIcon.ContextFlyout>
						<MenuFlyout>
							<MenuFlyoutItem Command="{StaticResource Settings}" />
							<MenuFlyoutSeparator />
							<MenuFlyoutItem Command="{StaticResource Exit}" />
						</MenuFlyout>
					</tray:TaskbarIcon.ContextFlyout>
				</tray:TaskbarIcon>
			</ResourceDictionary>
		</ResourceDictionary>
	</Application.Resources>
</Application>
