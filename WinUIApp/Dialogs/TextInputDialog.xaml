<ContentDialog
	x:Class="WinUIApp.Dialogs.TextInputDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:models="using:WinUIApp.Models"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d"
	PrimaryButtonText="Ok"
	SecondaryButtonText="Cancel">
	<StackPanel>
		<StackPanel.Resources>
			<ResourceDictionary Source="/Validation/ValidationTemplates.xaml" />
		</StackPanel.Resources>
		
		<TextBlock x:Name="MessageContent" FontFamily="{x:Bind FontFamily}" FontSize="{x:Bind FontSize}" />

		<TextBox x:Name="TextValueInput" Style="{StaticResource ValidatedInputStyle}" Template="{StaticResource TextBoxErrorTemplate}" Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Loaded="TextValueInput_Loaded" />
	</StackPanel>
</ContentDialog>